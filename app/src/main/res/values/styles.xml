<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorAccent">#1F8A5F</item>
        <item name="android:colorAccent">#1F8A5F</item>
        <item name="android:windowBackground">#EEF8F1</item>
        <item name="android:navigationBarColor">#EEF8F1</item>
        <item name="android:statusBarColor">#F6FCF8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="ItemsDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#1F8A5F</item>
        <item name="android:colorAccent">#1F8A5F</item>
    </style>
    <!-- 事项编辑器以弹窗形式盖在当前页上，不切走整个页面 -->
    <style name="TranslucentItemsTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
